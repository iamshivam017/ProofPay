# Full paid Telegraph Engine/Miner endpoint used by POST /api/verify.
TELEGRAPH_ENGINE_URL=https://replace-with-organizer-endpoint.example/v1/ask

# Dedicated, low-balance Base Sepolia burner wallet. Never expose as NEXT_PUBLIC_*.
EXECUTOR_PRIVATE_KEY=0xreplace_with_64_hex_characters

# Trusted Base Sepolia RPC used for x402 checks and downstream ETH transfers.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Coinbase USDC on Base Sepolia; override only if organizers explicitly require it.
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Hard ceiling in USDC atomic units (6 decimals). 100000 = 0.10 USDC.
X402_MAX_PAYMENT_ATOMIC=100000

# Optional timeout; applies to the complete 402/payment/retry exchange.
TELEGRAPH_REQUEST_TIMEOUT_MS=30000
