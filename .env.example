# Full paid Telegraph Engine/Miner POST endpoint. Obtain this from Telegraph.
TELEGRAPH_ENGINE_URL="https://replace-with-organizer-endpoint.example/v1/verify"

# Dedicated, low-balance Base Sepolia burner. Never use NEXT_PUBLIC_*.
EXECUTOR_PRIVATE_KEY="0xYOUR_BURNER_PRIVATE_KEY"

# Base Sepolia RPC used for x402 checks and downstream ETH transfers.
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# Coinbase USDC on Base Sepolia. Change only when Telegraph explicitly requires it.
BASE_SEPOLIA_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# Maximum x402 charge in USDC atomic units (6 decimals): 100000 = 0.10 USDC.
X402_MAX_PAYMENT_ATOMIC="100000"

# Optional timeout for the complete challenge/payment/response exchange.
TELEGRAPH_REQUEST_TIMEOUT_MS="30000"
